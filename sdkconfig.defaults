# Kitchen Panel build defaults
# SparkFun Pro Micro ESP32-C3, 4MB flash: dual 1984KB OTA app slots
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA: pull over plain http on the LAN; roll back if the new app never
# marks itself healthy (done on the first MQTT connect)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Requests must never fire late (spec §4): anything still in the MQTT
# outbox after 4 s is dropped, inside the panel's 5 s "No response" window.
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=4000

# BLE (NimBLE) for Improv Wi-Fi provisioning; peripheral role only,
# controller trimmed to one advertisement + one connection to save RAM
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_CTRL_BLE_MAX_ACT=3

# RAM diet so BLE (~110KB) fits alongside Wi-Fi + LVGL on the C3's 400KB
# (same tuning as taskpad, which runs this board and panel).
CONFIG_LV_MEM_SIZE=32768
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# LVGL fonts used by the UI
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
